@model List<ServiceFlow.CRM.Models.Customer>

@{
    ViewData["Title"] = "Müşteriler";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Müşteriler</h2>
        <p class="text-muted mb-0">CRM içerisindeki müşteri kayıtlarını yönetin.</p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        + Yeni Müşteri
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        @if (!Model.Any())
        {
            <div class="text-center text-muted py-5">
                Henüz müşteri eklenmemiş.
            </div>
        }
        else
        {
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Ad Soyad</th>
                        <th>E-posta</th>
                        <th>Telefon</th>
                        <th>Firma</th>
                        <th>Kayıt Tarihi</th>
                        <th class="text-end">İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var customer in Model)
                    {
                        <tr>
                            <td>@customer.FullName</td>
                            <td>@customer.Email</td>
                            <td>@customer.Phone</td>
                            <td>@customer.CompanyName</td>
                            <td>@customer.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@customer.Id" class="btn btn-sm btn-warning">
                                    Düzenle
                                </a>

                                <form asp-action="Delete" asp-route-id="@customer.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-sm btn-danger"
                                            onclick="return confirm('Bu müşteriyi silmek istediğine emin misin?')">
                                        Sil
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>